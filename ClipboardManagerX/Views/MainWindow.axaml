<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipboardManagerX.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:converters="clr-namespace:ClipboardManagerX.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ClipboardManagerX.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="450" Height="600"
        WindowStartupLocation="Manual"
        Icon="avares://ClipboardManagerX/Assets/icon-dark.ico"
        Title="ClipX">

    <Window.Resources>
        <converters:TruncateConverter x:Key="Truncate500Converter" MaxLength="500" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8">
            <Button Command="{Binding ClearClipboardCommand}" ToolTip.Tip="Clear Clipboard">
                <avalonia:FluentIcon Icon="ClipboardChatEmpty" FontSize="16" />
            </Button>
            <Button Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear Clipboard History">
                <avalonia:FluentIcon Icon="Delete" FontSize="16" />
            </Button>
        </StackPanel>

        <!-- Clipboard List -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <ListBox ItemsSource="{Binding ClipboardHistory}"
                     SelectionMode="Single"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:ClipBoardItem">
                        <Setter Property="ToolTip.Tip" Value="{Binding Text, Converter={StaticResource Truncate500Converter}}" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipBoardItem">
                        <Border Padding="8,6" CornerRadius="4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Text Preview (Truncated up to 2 lines) -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Text}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Inline Copy Button bound to MainViewModel.CopyCommand -->
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Copy this item">
                                    <avalonia:FluentIcon Icon="Copy" FontSize="14" />
                                </Button>

                                <!-- Timestamp -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
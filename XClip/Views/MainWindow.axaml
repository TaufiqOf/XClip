<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XClip.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:converters="clr-namespace:XClip.Converters"
        xmlns:models="clr-namespace:XClip.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="XClip.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="450" Height="600"
        WindowStartupLocation="Manual"
        Icon="avares://XClip/Assets/icon-dark.ico"
        Title="XClip">

    <Window.Resources>
        <converters:TruncateConverter x:Key="Truncate500Converter" MaxLength="300" />
        <converters:IsImageFormatConverter x:Key="IsImageFormatConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Toolbar Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,8,8,4">
            <!-- Left Aligned Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding ClearClipboardCommand}" ToolTip.Tip="Clear Clipboard">
                    <avalonia:FluentIcon Icon="ClipboardChatEmpty" FontSize="16" />
                </Button>
                <Button Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear Clipboard History">
                    <avalonia:FluentIcon Icon="Delete" FontSize="16" />
                </Button>

                <!-- Auto Start Toggle -->
                <ToggleButton IsChecked="{Binding IsAutoStartEnabled}"
                              ToolTip.Tip="Toggle Auto Start">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Play" FontSize="16" />
                    </StackPanel>
                </ToggleButton>

                <!-- Monitor Clipboard Toggle -->
                <ToggleButton IsChecked="{Binding IsMonitoringClipboard}"
                              ToolTip.Tip="Toggle Clipboard Monitoring">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Eye" FontSize="16" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Right Aligned Settings Button -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings">
                <avalonia:FluentIcon Icon="Settings" FontSize="16" />
            </Button>
        </Grid>

        <!-- Search Input Box -->
        <Grid Grid.Row="1" Margin="8,4">
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search history (Ctrl+S)..." />
        </Grid>

        <!-- Clipboard List -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <ListBox
                x:Name="ListBox"
                ItemsSource="{Binding FilteredHistory}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="models:ClipboardItem">
                        <Setter Property="ToolTip.Tip"
                                Value="{Binding Text, Converter={StaticResource Truncate500Converter}}" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
   
                    <DataTemplate x:DataType="models:ClipboardItem">
          
                        <Border Padding="8,6" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="DoubleTapped">
                                        <InvokeCommandAction
                                            Command="{Binding DoubleClickCommand}"
                                            CommandParameter="{Binding}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                                <!-- Index Badge (Column 0) -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                        Background="#2D2D2D"
                                        CornerRadius="4"
                                        Width="22" Height="22"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                       
                                    <TextBlock Text="{Binding DisplayIndex}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#AAAAAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Image Preview (Column 1 - Only visible for images) -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        Width="72" Height="48"
                                        Margin="0,0,10,0"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        IsVisible="{Binding Format, Converter={StaticResource IsImageFormatConverter}}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                    <Image Source="{Binding ImageData}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Text Preview (Column 2 - Always Visible) -->
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding DisplayText}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0" />

                                <!-- Type + Timestamp (Column 2 - Always Visible) -->
                                <StackPanel Grid.Row="1" Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,4,0,0">
                                    <Border Background="#202020"
                                            CornerRadius="3"
                                            Padding="6,1">
                                        <TextBlock Text="{Binding Format}"
                                                   FontSize="10"
                                                   Foreground="#B8B8B8" />
                                    </Border>

                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                               FontSize="11"
                                               Foreground="#888888" />
                                </StackPanel>

                                <!-- Inline Delete Button (Column 3) -->
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Delete this item">
                                    <avalonia:FluentIcon Icon="Delete" FontSize="14" />
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
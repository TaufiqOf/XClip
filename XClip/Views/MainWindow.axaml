<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XClip.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:converters="clr-namespace:XClip.Converters"
        xmlns:models="clr-namespace:XClip.Models"
        xmlns:services="clr-namespace:XClip.Services"
        xmlns:helper="clr-namespace:XClip.Helper"
        xmlns:controls="clr-namespace:XClip.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="XClip.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="450" Height="600"
        WindowStartupLocation="Manual"
        Icon="avares://XClip/Assets/icon-dark.ico"
        Title="XClip">

    <Window.Resources>
        <converters:TruncateConverter x:Key="Truncate500Converter" MaxLength="300" />
        <converters:IsImageFormatConverter x:Key="IsImageFormatConverter" />
        <converters:ToUpperConverter x:Key="ToUpperConverter" />
        <!-- Clipboard Item Template Selector -->
        <!-- Clipboard Item Template Selector -->
        <helper:ClipboardItemTemplateSelector x:Key="ClipboardItemSelector">

            <!-- TEXT FORMAT TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.Text}" x:DataType="models:ClipboardItem">
                <controls:TextItemControl />
            </DataTemplate>

            <!-- IMAGE FORMAT TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.Image}" x:DataType="models:ClipboardItem">
                <controls:ImageItemControl />
            </DataTemplate>

            <!-- STORAGE ITEMS (FILES) TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.StorageItems}" x:DataType="models:ClipboardItem">
                <controls:StorageItemsControl />
            </DataTemplate>

        </helper:ClipboardItemTemplateSelector>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Toolbar Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,8,8,4">
            <!-- Left Aligned Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding ClearClipboardCommand}" ToolTip.Tip="Clear Clipboard">
                    <avalonia:FluentIcon Icon="ClipboardChatEmpty" FontSize="16" />
                </Button>
                <Button Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear Clipboard History">
                    <avalonia:FluentIcon Icon="Delete" FontSize="16" />
                </Button>

                <!-- Auto Start Toggle -->
                <ToggleButton IsChecked="{Binding IsAutoStartEnabled}"
                              ToolTip.Tip="Toggle Auto Start">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Play" FontSize="16" />
                    </StackPanel>
                </ToggleButton>

                <!-- Monitor Clipboard Toggle -->
                <ToggleButton IsChecked="{Binding IsMonitoringClipboard}"
                              ToolTip.Tip="Toggle Clipboard Monitoring">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Eye" FontSize="16" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Right Aligned Settings Button -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings">
                <avalonia:FluentIcon Icon="Settings" FontSize="16" />
            </Button>
        </Grid>

        <!-- Search Input Box -->
        <Grid Grid.Row="1" Margin="8,4">
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search history (Ctrl+S)..." />
        </Grid>

        <!-- Clipboard List -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <ListBox
                x:Name="ListBox"
                ItemsSource="{Binding FilteredHistory}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                ItemTemplate="{StaticResource ClipboardItemSelector}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="models:ClipboardItem">
                        <!-- Remove default padding and margins applied by the Avalonia theme -->
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="ToolTip.Tip" Value="{Binding DisplayText}" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Grid>
    </Grid>
</Window>